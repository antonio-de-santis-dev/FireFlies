# Copia questo file in infra/.env e scegli una password locale.
# infra/.env è ignorato da git: non committarlo. Nessun valore qui è un segreto reale.
FIREFLIES_DB_NAME=fireflies
FIREFLIES_DB_USER=fireflies
FIREFLIES_DB_PASSWORD=
FIREFLIES_DB_PORT=5432
FIREFLIES_DB_URL=jdbc:postgresql://localhost:5432/fireflies
